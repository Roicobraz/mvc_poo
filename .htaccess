SetEnv URL "http://localhost/dev_web/mvc_poo/"

<IfModule mod_rewrite.c>
RewriteEngine On

RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^localhost$
RewriteCond %{REQUEST_URI} !dev_web/mvc_poo/public/
RewriteRule (.*) /dev_web/mvc_poo/public/$1 [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /dev_web/mvc_poo/index.php?route=$1 [QSA,L]

ErrorDocument 404 {ENV:URL}error404
</IfModule>

<IfModule mod_headers.c>
Header set Content-Security-Policy "script-src {ENV:URL}js/, 'none'"
Header set Content-Security-Policy "img-src {ENV:URL}img/"
Header set Content-Security-Policy "style-src {ENV:URL}css/" 
Header set Content-Security-Policy "font-src {ENV:URL}font/"
Header set Content-Security-Policy "object-src 'none'"
Header set Content-Security-Policy "base-uri 'self'"

Header set Content-Security-Policy "frame-ancestors 'none'"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set Permissions-Policy "accelerometer=(), geolocation=('self'), fullscreen=(), ambient-light-sensor=(), autoplay=(), battery=(), camera=(), display-capture=('self')" 
Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
Header set X-Content-Type-Options "nosniff" 
</IfModule>